# ==============================================================================
# LinkCloud - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Fill in production values using the generated secrets instructions below.
# 3. DO NOT commit '.env' or any credentials to Git (enforced via .gitignore).
# ==============================================================================

# Application Environment
# Options: 'development' | 'production'
FLASK_ENV=production

# Flask Debug Mode (Must be 0 in production; debug mode is strictly forbidden in production)
FLASK_DEBUG=0

# Application Secret Key
# Required in production. Must be at least 32 characters long.
# Generate a cryptographically secure key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-cryptographically-secure-random-32-byte-hex-string

# Administrator Authentication
# The username required to log into LinkCloud admin panel
ADMIN_USERNAME=admin

# Administrator Password Hash (Required in production)
# Generate using Werkzeug's secure hashing (scrypt / pbkdf2):
#   python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YOUR_CHOSEN_PASSWORD'))"
ADMIN_PASSWORD_HASH=pbkdf2:sha256:600000$placeholderhashsalt$placeholderhashvalueonly

# Optional Plaintext Password (For local development testing ONLY; ignored if ADMIN_PASSWORD_HASH is set)
# ADMIN_PASSWORD=optional-dev-password-here

# Session Cookie Security
# Set to 1 (True) when serving over HTTPS. (Automatically defaults to 1 when FLASK_ENV=production)
SESSION_COOKIE_SECURE=1

# Reverse Proxy Support
# Set to 1 if LinkCloud is running behind Nginx, AWS ALB, or another reverse proxy.
# This enables Werkzeug ProxyFix to safely parse X-Forwarded-For and X-Forwarded-Proto headers.
BEHIND_PROXY=1

# Rate Limiting Configuration (Maximum requests allowed per window per client IP)
# Window duration: 60 seconds
RATE_LIMIT_REDIRECT_PER_MIN=120
RATE_LIMIT_QR_PER_MIN=60
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_SHORTEN_PER_MIN=30

# Web Server Port
PORT=5000
